# Environment
NODE_ENV=development
PORT=3000
APP_CORS_ORIGIN=http://localhost:3001

# PostgreSQL Database
DATABASE_URL=postgresql://petals_admin:petals_password@localhost:5432/petals_erp?schema=public
# Direct URL if connection pooling is used
DIRECT_URL=postgresql://petals_admin:petals_password@localhost:5432/petals_erp?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_ACCESS_SECRET=super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-secret-change-in-production

# Storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=petals-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=

